[worldserver]

###################################################################################################
# Moonlit Callings (testing stage)
###################################################################################################

# Enable the Callings lock? When on, the classes below cannot gain stock talents or buy trainer spells.
# The Callings Lua system (lua_scripts/moonlit_callings) grants everything instead. (1 = on, 0 = off)
MoonlitCallings.Enable = 1

# Class IDs that use the Callings system: 5 = Priest, 7 = Shaman (comma separated)
MoonlitCallings.Classes = "5,7"
